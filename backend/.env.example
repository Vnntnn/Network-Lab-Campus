# Backend runtime settings
# Use PostgreSQL in production if possible.
DATABASE_URL=sqlite+aiosqlite:///./nexus_edu.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://app.example.com

# Fernet key for at-rest credential encryption.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, credentials stored plaintext (dev only — always set in production).
CREDENTIAL_KEY=

# Instructor dashboard PIN (change from default "1234" in production).
INSTRUCTOR_PIN=change-me
